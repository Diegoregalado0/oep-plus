{
  "name": "oep-plus",
  "version": "1.0.0",
  "private": true,
  "description": "UC Merced Outdoor Experience Program trip and expedition management",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "./scripts/reset-db.sh",
    "db:psql": "docker compose exec db psql -U oep -d oep",
    "demo:rules": "./scripts/demo-rules.sh",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node scripts/api-test.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "pg": "^8.12.0"
  }
}
